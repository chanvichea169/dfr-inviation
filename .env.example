# Google Service Account credentials for the /api/invitation serverless function.
# Copy this file to `.env` and fill in real values. NEVER put real secrets here.
# Add the same values in Vercel: Project Settings -> Environment Variables.

# Recommended for Vercel: base64 encode the whole Google service account JSON
# file and set this single value.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Alternative separate values:
# Service account email, e.g. my-bot@my-project.iam.gserviceaccount.com
GOOGLE_CLIENT_EMAIL=

# The private_key value from the service account JSON. Keep the surrounding
# quotes and the literal \n escape sequences on one line.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional separate-key alternative: base64 encode only the full private_key
# value and set this instead of GOOGLE_PRIVATE_KEY.
GOOGLE_PRIVATE_KEY_BASE64=

# The spreadsheet ID (the long id in the sheet URL: /spreadsheets/d/<THIS>/edit)
GOOGLE_SPREADSHEET_ID=
