# Google Service Account credentials for the /api/invitation serverless function.
# Copy this file to `.env` and fill in real values. NEVER put real secrets here.
# Add the same values in Vercel: Project Settings → Environment Variables.

# Service account email, e.g. my-bot@my-project.iam.gserviceaccount.com
GOOGLE_CLIENT_EMAIL=

# The private key from the service account JSON. Keep the surrounding quotes
# and the literal \n escape sequences on one line.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID (the long id in the sheet URL: /spreadsheets/d/<THIS>/edit)
GOOGLE_SPREADSHEET_ID=
